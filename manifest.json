{
  "manifest_version": 3,
  "name": "Tabularium",
  "version": "0.1.0",
  "description": "A Kanban dashboard for your browser tabs, on every New Tab.",
  "minimum_chrome_version": "119",
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
