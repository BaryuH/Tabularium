{
  "name": "tabularium",
  "version": "0.1.0",
  "description": "A Kanban dashboard for your browser tabs, on every New Tab.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
