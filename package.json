    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@eslint/js": "^9.9.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "lucide": "^1.46.0"
  }
}
